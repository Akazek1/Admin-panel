# =============================================================
# Huza Admin Panel — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; only this example is committed.
# =============================================================

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3003

# Socket.io server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# Must match HWA_Backend JWT_SECRET. Used by middleware to verify admin JWTs.
ADMIN_JWT_SECRET=replace-with-backend-jwt-secret
